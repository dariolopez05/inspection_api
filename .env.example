# Postgres
POSTGRES_USER=inspection
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=inspection_db

# host-side = localhost; dentro de compose la api usa host = db
DATABASE_URL=postgresql+psycopg://inspection:change_me_in_prod@localhost:5432/inspection_db

API_KEY=dev-secret-api-key-change-me
RATE_LIMIT_PER_MINUTE=120

MODEL_PATH=models/damage_classifier.h5

# MinIO (simula S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# S3 / MinIO. host-side = localhost; dentro de compose la api usa http://minio:9000
S3_ENDPOINT_URL=http://localhost:9000
# host que firma las presigned URLs (lo que abre el navegador del cliente)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=car-images
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY=3600

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
